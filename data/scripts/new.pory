	//} else {
    //    call(EventScript_RandomWeather_DoCurrent)
	//}
}
script(local) EventScript_RandomWeather_SetNext {
	copyvar(VAR_LAST_HOUR, CURRENT_HOUR)
	copyvar(VAR_LAST_MINUTE, CURRENT_MINUTE)
    
    // Move next weather to current. There should be NUM_WEATHER_SLOTS instructions here
    copyvar(VAR_CURRENT_WEATHER, VAR_NEXT_WEATHER)
    copyvar(VAR_NEXT_WEATHER, VAR_NEXT2_WEATHER)

    // Execute current
    call(EventScript_RandomWeather_DoCurrent)

    // Determine new next. Always sunny if pokedex is unobtained otherwise random
    setvar(SHOULDNT_CONTINUE, FALSE)
    random(120)
    //TWcopyvar(VAR_TEMP_F, VAR_RESULT)
    switch(var(VAR_WEATHER_SET)) {
        default:
        case WEATHER_SET_DEFAULT:
            if (var(VAR_RESULT) > 99) {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_RAIN)
            } else {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_SUNNY)
            }
        case WEATHER_SET_DEFAULT_PLUS:
            if(var(VAR_RESULT) > 99) {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_THUNDERSTORM)
                if((var(VAR_CURRENT_WEATHER) == RANDOM_WEATHER_THUNDERSTORM)
                && random(50) > 29) {
                    setvar(VAR_NEXT_WEATHER, RANDOM_WEATHER_SHADE)
                    setvar(SHOULDNT_CONTINUE, TRUE)
                }
            } elif(var(VAR_RESULT) > 79) {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_SHADE)
                if((var(VAR_CURRENT_WEATHER) == RANDOM_WEATHER_SHADE)
                 && random(50) > 29) {
                    setvar(SHOULDNT_CONTINUE, TRUE)
                    if(!random(2)) {
                        setvar(VAR_NEXT_WEATHER, RANDOM_WEATHER_THUNDERSTORM)
                    } else {
                        setvar(VAR_NEXT_WEATHER, RANDOM_WEATHER_RAIN)
                    }
                }
            } elif (var(VAR_RESULT) > 59) {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_RAIN)
                if((var(VAR_CURRENT_WEATHER) == RANDOM_WEATHER_RAIN)
                && random(50) > 29) {
                    setvar(VAR_NEXT_WEATHER, RANDOM_WEATHER_SHADE)
                    setvar(SHOULDNT_CONTINUE, TRUE)
                }
            } else {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_SUNNY)
            }
        case WEATHER_SET_ANY:
            if(var(VAR_RESULT) > 114) {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_SNOW)
            } elif(var(VAR_RESULT) > 109) {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_THUNDERSTORM)
                if((var(VAR_CURRENT_WEATHER) == RANDOM_WEATHER_THUNDERSTORM)
                 && random(50) > 29) {
                    setvar(VAR_NEXT_WEATHER, RANDOM_WEATHER_SHADE)
                    setvar(SHOULDNT_CONTINUE, TRUE)
                }
            } elif(var(VAR_RESULT) > 99) {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_SHADE)
                if((var(VAR_CURRENT_WEATHER) == RANDOM_WEATHER_SHADE)
                 && random(50) > 29) {
                    setvar(SHOULDNT_CONTINUE, TRUE)
                    if(!random(2)) {
                        setvar(VAR_NEXT_WEATHER, RANDOM_WEATHER_THUNDERSTORM)
                    } else {
                        setvar(VAR_NEXT_WEATHER, RANDOM_WEATHER_RAIN)
                    }
                }
            } elif(var(VAR_RESULT) > 89) {
                // Drought between 10a-5p, otherwise fog
                gettime
                if(var(CURRENT_HOUR) <= DROUGHT_SET_MAX
                && var(CURRENT_HOUR) >= DROUGHT_SET_MIN) {
                    setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_DROUGHT)
                } else {
                    setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_FOG)
                }
            } elif(var(VAR_RESULT) > 59) {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_RAIN)
            } else {
                setvar(VAR_NEXT2_WEATHER, RANDOM_WEATHER_SUNNY)
            }
    }

    // Random chance to continue current weather
    if(var(SHOULDNT_CONTINUE) == FALSE
    && var(VAR_CURRENT_WEATHER) != RANDOM_WEATHER_SUNNY
    && var(VAR_CURRENT_WEATHER) != RANDOM_WEATHER_FORCED_SUNNY) {
        switch(var(VAR_WEATHER_SET)) {
            default:
                if(!random(5)) {
                    //TWsetvar(VAR_TEMP_F, 231)
                    copyvar(VAR_NEXT_WEATHER, VAR_CURRENT_WEATHER)
                }
            case WEATHER_SET_DEFAULT:
                if(!random(2)) {
                    //TWsetvar(VAR_TEMP_F, 231)
                    copyvar(VAR_NEXT_WEATHER, VAR_CURRENT_WEATHER)
                }
        }
    }
}
script(local) EventScript_RandomWeather_DoCurrent {
    switch(var(VAR_CURRENT_WEATHER)) {
        case RANDOM_WEATHER_RAIN:
            setweather(WEATHER_RAIN)
        case RANDOM_WEATHER_DROUGHT:
            gettime
            if(var(CURRENT_HOUR) <= DROUGHT_MAX
            && var(CURRENT_HOUR) >= DROUGHT_MIN) {
                setweather(WEATHER_DROUGHT)
            } else {
                setweather(WEATHER_FOG_HORIZONTAL)
                setvar(VAR_CURRENT_WEATHER, RANDOM_WEATHER_FOG)
            }
        case RANDOM_WEATHER_SHADE:
            setweather(WEATHER_SHADE)
        case RANDOM_WEATHER_THUNDERSTORM:
            setweather(WEATHER_RAIN_THUNDERSTORM)
        case RANDOM_WEATHER_SNOW:
            setweather(WEATHER_SNOW)
        case RANDOM_WEATHER_FOG:
            gettime
            if(var(CURRENT_HOUR) > DROUGHT_MAX
            || var(CURRENT_HOUR) < DROUGHT_MIN) {
                setweather(WEATHER_FOG_HORIZONTAL)
            } else {
                setweather(WEATHER_DROUGHT)
                setvar(VAR_CURRENT_WEATHER, RANDOM_WEATHER_DROUGHT)
            }
        case RANDOM_WEATHER_FORCED_SUNNY:
        default:
            setweather(WEATHER_SUNNY)
    }
    doweather
}

script EventScript_TimeWeather {
	lockall
    //call(EventScript_RandomWeather)
	call(EventScript_BufferTime)
    msgbox("Current Time: {STR_VAR_1}:{STR_VAR_2}{STR_VAR_3}")
	call(EventScript_BufferLastTime)
    msgbox("Last Time: {STR_VAR_1}:{STR_VAR_2}{STR_VAR_3}")
	switch(var(VAR_CURRENT_WEATHER)) { 
		case RANDOM_WEATHER_RAIN:
			bufferstring(STR_VAR_1, "Rain")
		case RANDOM_WEATHER_DROUGHT:
			bufferstring(STR_VAR_1, "Drought")
		case RANDOM_WEATHER_SHADE:
			bufferstring(STR_VAR_1, "Shade")
		case RANDOM_WEATHER_THUNDERSTORM:
			bufferstring(STR_VAR_1, "Thunderstorm")
		case RANDOM_WEATHER_SNOW:
			bufferstring(STR_VAR_1, "Snow")
		case RANDOM_WEATHER_FOG:
			bufferstring(STR_VAR_1, "Fog")
		case RANDOM_WEATHER_FORCED_SUNNY:
			bufferstring(STR_VAR_1, "Forced Clear")
		default:
			bufferstring(STR_VAR_1, "Clear")
	}    
	switch(var(VAR_WEATHER_SET)) { 
		case WEATHER_SET_DEFAULT:
			bufferstring(STR_VAR_2, "Default")
		case WEATHER_SET_DEFAULT_PLUS:
			bufferstring(STR_VAR_2, "Default+")
		case WEATHER_SET_RAIN_ONLY:
			bufferstring(STR_VAR_2, "Rain Only")
		case WEATHER_SET_RAIN_PLUS:
			bufferstring(STR_VAR_2, "Rain+")
		case WEATHER_SET_SNOW_CYCLE:
			bufferstring(STR_VAR_2, "Snow Cycle")
		case WEATHER_SET_SNOW_ONLY:
			bufferstring(STR_VAR_2, "Snow Only")
		case WEATHER_SET_ANY:
			bufferstring(STR_VAR_2, "Any/Unset")
	}    
	msgbox("Weather Set: {STR_VAR_2}\n"
           "Current weather: {STR_VAR_1}")
	switch(var(VAR_NEXT2_WEATHER)) { 
		case RANDOM_WEATHER_RAIN:
			bufferstring(STR_VAR_1, "Rain")
		case RANDOM_WEATHER_DROUGHT:
			bufferstring(STR_VAR_1, "Drought")
		case RANDOM_WEATHER_SHADE:
			bufferstring(STR_VAR_1, "Shade")
		case RANDOM_WEATHER_THUNDERSTORM:
			bufferstring(STR_VAR_1, "Thunderstorm")
		case RANDOM_WEATHER_SNOW:
			bufferstring(STR_VAR_1, "Snow")
		case RANDOM_WEATHER_FOG:
			bufferstring(STR_VAR_1, "Fog")
		case RANDOM_WEATHER_FORCED_SUNNY:
			bufferstring(STR_VAR_1, "Forced Clear")
		default:
			bufferstring(STR_VAR_1, "Clear")
	}
	switch(var(VAR_NEXT_WEATHER)) { 
		case RANDOM_WEATHER_RAIN:
			bufferstring(STR_VAR_3, "Rain")
		case RANDOM_WEATHER_DROUGHT:
			bufferstring(STR_VAR_3, "Drought")
		case RANDOM_WEATHER_SHADE:
			bufferstring(STR_VAR_3, "Shade")
		case RANDOM_WEATHER_THUNDERSTORM:
			bufferstring(STR_VAR_3, "Thunderstorm")
		case RANDOM_WEATHER_SNOW:
			bufferstring(STR_VAR_3, "Snow")
		case RANDOM_WEATHER_FOG:
			bufferstring(STR_VAR_3, "Fog")
		case RANDOM_WEATHER_FORCED_SUNNY:
			bufferstring(STR_VAR_3, "Forced Clear")
		default:
			bufferstring(STR_VAR_3, "Clear")
	}
    switch(var(VAR_TEMP_F)) {
        case 231: // Current weather was continued
            msgbox("Next2: {STR_VAR_1}\n"
                   "Next: {STR_VAR_3} (continued)")
        case 232: // Pokédex is unobtained
            msgbox("Pokédex Unobtained\n"
                   "Next2: {STR_VAR_1}\l"
                   "Next: {STR_VAR_3}")
        case 233: // Flag FLAG_SYS_WEATHER_CTRL is on
            msgbox("Weather disabled via flag")
        default:
            buffernumberstring(STR_VAR_2, VAR_TEMP_F)
            msgbox("Next2: {STR_VAR_1}, rolled {STR_VAR_2}\n"
                   "Next: {STR_VAR_3}")
    }
    closemessage
    releaseall
	end
}

script EventScript_BufferTime {
    // Bufers the current hour to STR_VAR_1,
    // the current minute to STR_VAR_2,
    // and time of day (AM/PM) to STR_VAR_3
    gettime
    
    // Hour
    if(!flag(FLAG_SYS_USE_24HR)) {
        copyvar(TEMP_HOUR, CURRENT_HOUR)
        if(var(TEMP_HOUR) == HOUR_12AM) {
            setvar(TEMP_HOUR, 12)
        } elif(var(TEMP_HOUR) > HOUR_12PM) {
            subvar(TEMP_HOUR, 12)
        } 
        buffernumberstring(STR_VAR_1, TEMP_HOUR)

        // AM/PM
        if(var(CURRENT_HOUR) < HOUR_12PM) {
            bufferstring(STR_VAR_3, " AM")
        } else {
            bufferstring(STR_VAR_3, " PM")
        }
    } else {
        bufferstring(STR_VAR_3, "")
        switch(var(CURRENT_HOUR)) {
            default:
                buffernumberstring(STR_VAR_1, CURRENT_HOUR)
            case HOUR_12AM:
                bufferstring(STR_VAR_1, "00")
            case HOUR_1AM:
                bufferstring(STR_VAR_1, "01")
            case HOUR_2AM:
                bufferstring(STR_VAR_1, "02")
            case HOUR_3AM:
                bufferstring(STR_VAR_1, "03")
            case HOUR_4AM:
                bufferstring(STR_VAR_1, "04")
            case HOUR_5AM:
                bufferstring(STR_VAR_1, "05")
            case HOUR_6AM:
                bufferstring(STR_VAR_1, "06")
            case HOUR_7AM:
                bufferstring(STR_VAR_1, "07")
            case HOUR_8AM:
                bufferstring(STR_VAR_1, "08")
            case HOUR_9AM:
                bufferstring(STR_VAR_1, "09")
        }
    }

    // Minute
    switch(var(CURRENT_MINUTE)) {
        default:
            buffernumberstring(STR_VAR_2, CURRENT_MINUTE)
        case 0:
            bufferstring(STR_VAR_2, "00")
        case 1:
            bufferstring(STR_VAR_2, "01")
        case 2:
            bufferstring(STR_VAR_2, "02")
        case 3:
            bufferstring(STR_VAR_2, "03")
        case 4:
            bufferstring(STR_VAR_2, "04")
        case 5:
            bufferstring(STR_VAR_2, "05")
        case 6:
            bufferstring(STR_VAR_2, "06")
        case 7:
            bufferstring(STR_VAR_2, "07")
        case 8:
            bufferstring(STR_VAR_2, "08")
        case 9:
            bufferstring(STR_VAR_2, "09")
    }
}
script EventScript_BufferLastTime {
    // Bufers the last hour to STR_VAR_1,
    // the last minute to STR_VAR_2,
    // and time of day (AM/PM) to STR_VAR_3
    
    // Hour
    if(!flag(FLAG_SYS_USE_24HR)) {
        copyvar(TEMP_HOUR, VAR_LAST_HOUR)
        if(var(TEMP_HOUR) == HOUR_12AM) {
            setvar(TEMP_HOUR, 12)
        } elif(var(TEMP_HOUR) > HOUR_12PM) {
            subvar(TEMP_HOUR, 12)
        } 
        buffernumberstring(STR_VAR_1, TEMP_HOUR)

        // AM/PM
        if(var(VAR_LAST_HOUR) < HOUR_12PM) {
            bufferstring(STR_VAR_3, " AM")
        } else {
            bufferstring(STR_VAR_3, " PM")
        }
    } else {
        bufferstring(STR_VAR_3, "")
        switch(var(VAR_LAST_HOUR)) {
            default:
                buffernumberstring(STR_VAR_1, VAR_LAST_HOUR)
            case HOUR_12AM:
                bufferstring(STR_VAR_1, "00")
            case HOUR_1AM:
                bufferstring(STR_VAR_1, "01")
            case HOUR_2AM:
                bufferstring(STR_VAR_1, "02")
            case HOUR_3AM:
                bufferstring(STR_VAR_1, "03")
            case HOUR_4AM:
                bufferstring(STR_VAR_1, "04")
            case HOUR_5AM:
                bufferstring(STR_VAR_1, "05")
            case HOUR_6AM:
                bufferstring(STR_VAR_1, "06")
            case HOUR_7AM:
                bufferstring(STR_VAR_1, "07")
            case HOUR_8AM:
                bufferstring(STR_VAR_1, "08")
            case HOUR_9AM:
                bufferstring(STR_VAR_1, "09")
        }
    }

    // Minute
    switch(var(VAR_LAST_MINUTE)) {
        default:
            buffernumberstring(STR_VAR_2, VAR_LAST_MINUTE)
        case 0:
            bufferstring(STR_VAR_2, "00")
        case 1:
            bufferstring(STR_VAR_2, "01")
        case 2:
            bufferstring(STR_VAR_2, "02")
        case 3:
            bufferstring(STR_VAR_2, "03")
        case 4:
            bufferstring(STR_VAR_2, "04")
        case 5:
            bufferstring(STR_VAR_2, "05")
        case 6:
            bufferstring(STR_VAR_2, "06")
        case 7:
            bufferstring(STR_VAR_2, "07")
        case 8:
            bufferstring(STR_VAR_2, "08")
        case 9:
            bufferstring(STR_VAR_2, "09")
    }
}

