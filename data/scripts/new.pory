const CURRENT_HOUR = VAR_0x8000
const CURRENT_MINUTE = VAR_0x8001
const TEMP_HOUR = VAR_TEMP_A
const TEMP_MINUTE = VAR_TEMP_B
const SHOULDNT_CONTINUE = VAR_TEMP_C

// TODO:
// make weather advance every 30 mins instead of every hour
// buffer last recorded time
// buffer expected cycle time

// To properly enable the TimeWeather func, delete the following
//                              //TW                   

const NUM_WEATHER_SLOTS = 2 // Number of vars used before VAR_CURRENT_WEATHER

const RANDOM_WEATHER_SUNNY = 0
const RANDOM_WEATHER_RAIN = 1
const RANDOM_WEATHER_DROUGHT = 2
const RANDOM_WEATHER_SHADE = 3
const RANDOM_WEATHER_THUNDERSTORM = 4
const RANDOM_WEATHER_SNOW = 5
const RANDOM_WEATHER_FOG = 6
const RANDOM_WEATHER_FORCED_SUNNY = 7

// Time constants
const HOUR_12AM =  0
const  HOUR_1AM =  1
const  HOUR_2AM =  2
const  HOUR_3AM =  3
const  HOUR_4AM =  4
const  HOUR_5AM =  5
const  HOUR_6AM =  6
const  HOUR_7AM =  7
const  HOUR_8AM =  8
const  HOUR_9AM =  9
const HOUR_10AM = 10
const HOUR_11AM = 11
const HOUR_12PM = 12
const  HOUR_1PM = 13
const  HOUR_2PM = 14
const  HOUR_3PM = 15
const  HOUR_4PM = 16
const  HOUR_5PM = 17
const  HOUR_6PM = 18
const  HOUR_7PM = 19
const  HOUR_8PM = 20
const  HOUR_9PM = 21
const HOUR_10PM = 22
const HOUR_11PM = 23

script BufferWelcomeTextByTime {
    gettime
    if((var(CURRENT_HOUR) >= HOUR_7PM)
    || (var(CURRENT_HOUR) <= HOUR_3AM)) {
        bufferstring(STR_VAR_1, "Good evening")
    } elif(var(CURRENT_HOUR) < HOUR_12PM) {
        bufferstring(STR_VAR_1, "Good morning")
    } else {
        bufferstring(STR_VAR_1, "Welcome")
    }
}
script BufferClerkTextByTime {
    call(BufferWelcomeTextByTime)
    message("{STR_VAR_1}!\n"
            "How may I serve you?")
}

script BufferNurseTextByTime {
    call(BufferWelcomeTextByTime)
    msgbox("{STR_VAR_1}! Would you like me to heal\n"
           "your Pokémon back to perfect health?", MSGBOX_YESNO)
}

const DROUGHT_MIN = HOUR_10AM
const DROUGHT_MAX =  HOUR_6PM
const DROUGHT_SET_MIN = (DROUGHT_MIN - NUM_WEATHER_SLOTS)
const DROUGHT_SET_MAX = (DROUGHT_MAX - NUM_WEATHER_SLOTS)

