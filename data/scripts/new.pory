const TARGET_LEADER = VAR_0x8008
const LEADER_ARIA = 1
const LEADER_REDBEARD = 2
const LEADER_HASH = 3
const LEADER_LAURENT = 4
const LEADER_ALPH = 5
const LEADER_DULCE = 6
const LEADER_MARYANNE = 7
const LEADER_BOTOW = 8

script GymSetTrainersAndGiveTM {
    switch(var(TARGET_LEADER)) {
        case LEADER_ARIA:
            settrainerflag(TRAINER_JOSH)
            settrainerflag(TRAINER_TOMMY)
            settrainerflag(TRAINER_MARC)

            giveitem(ITEM_TM_AERIAL_ACE)

        case LEADER_REDBEARD:
            settrainerflag(TRAINER_TAKAO)
            settrainerflag(TRAINER_JOCELYN)
            settrainerflag(TRAINER_LAURA)
            settrainerflag(TRAINER_BRENDEN)
            settrainerflag(TRAINER_CRISTIAN)
            settrainerflag(TRAINER_LILITH)
            settrainerflag(TRAINER_DARIAN)

            giveitem(ITEM_TM_AQUA_CUTTER)

        default: // Failsafe
            giveitem(ITEM_NUGGET)
    }
    if(var(VAR_RESULT)) {
        switch(var(TARGET_LEADER)) {
            case LEADER_ARIA:
                setflag(FLAG_RECEIVED_TM_AERIAL_ACE)
                msgbox(format("This is a Techincal Machine, or “TM” for short. They can be used to teach your Pokémon neat moves, and can be used any number of times!\p"
                              "The TM I gave you contains the move Aerial Ace. It's a pretty swift Flying-type move that never misses!\p"
                              "Well, most of the time, usually."))
            case LEADER_REDBEARD:
                setflag(FLAG_RECEIVED_TM_AQUA_CUTTER)
                msgbox(format("I forged that TM with me own hook!\nHa ha!\p"
                              "That there be the move Aqua Cutter, a sharp Water-type move with a high critical-hit ratio!\p"
                              "Use it on a Pokémon with a divine cutlass! Ha ha ha!"))
            default: // Failsafe
                msgbox(format("My TM wasn't assigned, so I gave you that instead. Sorry!"))
        }
    } else {call(Common_EventScript_BagIsFull)}
}

script EventScript_ViewMap {
    lockall
    fadescreen(FADE_TO_BLACK)
    special(FieldShowRegionMap)
	releaseall
    end
}

script Common_EventScript_MartClerk {
	lock
	faceplayer
	call(BufferClerkTextByTime)
	waitmessage
	if(!flag(FLAG_SYS_POKEDEX_GET)) {
		pokemart(PokemartNoDex)
	} else {
		pokemart
	}
	msgbox(gText_PleaseComeAgain, MSGBOX_AUTOCLOSE)
	end
}

mart PokemartNoDex {
	ITEM_POTION
}

const TARGET_NPC_MON = VAR_TEMP_A

script StaticMonNpc {
    lock
	faceplayer
    if(!random(4)) {
		playmoncry(TARGET_NPC_MON, CRY_MODE_DOUBLES)
    } else {
	    playmoncry(TARGET_NPC_MON, CRY_MODE_NORMAL)
    }
	waitmoncry
    delay(8)
	release
	end
}