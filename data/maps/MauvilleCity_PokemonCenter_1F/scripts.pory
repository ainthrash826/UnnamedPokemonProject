mapscripts MauvilleCity_PokemonCenter_1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setrespawn(HEAL_LOCATION_MAUVILLE_CITY)
		end
	}
	MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script OlsternPokemonCenter1F_Nurse {
	setvar(VAR_0x800B, LOCALID_OLSTERN_NURSE)
	setvar(VAR_TEMP_A, FALSE)
	call(Common_EventScript_PkmnCenterNurse)
	waitmessage
	if(!var(VAR_TEMP_A)) {
		waitbuttonpress
	}
	turnobject(OBJ_EVENT_ID_PLAYER, DIR_SOUTH)
	release
	end
}

// NPCs

script OlsternPokemonCenter1F_Woman {
	msgbox(format("That man over there, he says weird things!\p"
                  "He's funny in a weird way. I doubt I'll forget about him!"), MSGBOX_NPC)
	end
}

script OlsternPokemonCenter1F_Sailor {
	msgbox(format("The Olstern Gym Leader moved here a few months ago.\p"
				  "Apparently, he used to be a professional racer."), MSGBOX_NPC)
	end
}

script OlsternPokemonCenter1F_Youngster {
	msgbox(format("A Record Corner opened upstairs in the Pokémon Center.\p"
                  "I don't know what it's about, but it sounds fun. I'll go check it out!"), MSGBOX_NPC)
	end
}
