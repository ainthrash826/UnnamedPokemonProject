script WatsonsLab_AdventureBooklet {
	lock
	message("What do you want to read about?")
	waitmessage
	switch(multichoice(12, 6, MULTI_UNUSED_9, FALSE)) {
		case 0: // catching a pkmn
			msgbox(format("catching a {PKMN}\p"
			              ""
						  "PLACEHOLDER"), MSGBOX_SIGN)
		case 1: // using dexnav
			msgbox(format("The DexNav can only be used in areas with wild Pokémon encounters.\p"
						  ""
			              "PLACEHOLDER"), MSGBOX_SIGN)
		case 2:
		case MULTI_B_PRESSED:
		default:
			release
			end
	}
	goto(WatsonsLab_AdventureBooklet)
}

script WatsonsLab_Starter {
	switch(var(VAR_STARTER_MON)) {
		case 0:
			setvar(VAR_TEMP_A, SPECIES_FROAKIE)
		case 1:
			setvar(VAR_TEMP_A, SPECIES_FUECOCO)
		case 2:
			setvar(VAR_TEMP_A, SPECIES_SNIVY)
		default:
			setvar(VAR_TEMP_A, SPECIES_RATTATA)
	}
    goto(StaticMonNpc)
}
script WatsonsLab_CaughtMon {
	switch(var(VAR_WATSON_CAUGHT_MON)) {
		case SPECIES_FLETCHLING:
			setvar(VAR_TEMP_A, SPECIES_FLETCHLING)
		case SPECIES_SENTRET:
			setvar(VAR_TEMP_A, SPECIES_SENTRET)
		case SPECIES_ROOKIDEE:
			setvar(VAR_TEMP_A, SPECIES_ROOKIDEE)
		case SPECIES_ZIGZAGOON_GALAR:
		case SPECIES_ZIGZAGOON:
			setvar(VAR_TEMP_A, SPECIES_ZIGZAGOON)
		case SPECIES_PIDOVE:
			setvar(VAR_TEMP_A, SPECIES_PIDOVE)
		case SPECIES_SHROODLE:
			setvar(VAR_TEMP_A, SPECIES_SHROODLE)
		case SPECIES_SKWOVET:
			setvar(VAR_TEMP_A, SPECIES_SKWOVET)
		case SPECIES_PURRLOIN:
			setvar(VAR_TEMP_A, SPECIES_PURRLOIN)
		case SPECIES_MUNCHLAX:
			setvar(VAR_TEMP_A, SPECIES_MUNCHLAX)
		default:
			setvar(VAR_TEMP_A, SPECIES_RATTATA)
	}
    goto(StaticMonNpc)
}