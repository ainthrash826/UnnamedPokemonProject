mapscripts LittlerootTown_ProfessorBirchsLab_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if(var(VAR_ANIMORA_CITY_STATE) < ANIMORA_STATE_COMPLETED_CATCH_TUTORIAL) {
			setmetatile(11, 1, 0x20B, TRUE)
		}
		switch(var(VAR_STARTER_MON)) {
			case 0:
				setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_SPECIES(FROAKIE))
			case 1:
				setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_SPECIES(FUECOCO))
			case 2:
				setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_SPECIES(SNIVY))
		}
		end
	}
	MAP_SCRIPT_ON_TRANSITION {
		setrespawn(HEAL_LOCATION_PETALBURG_CITY)
		if(var(VAR_ANIMORA_CITY_STATE) < ANIMORA_STATE_COMPLETED_CATCH_TUTORIAL) {
			setobjectxyperm(LOCALID_WATSONS_LAB_AIDE_2, 3, 5)
		}
		if(var(VAR_ANIMORA_CITY_STATE) == ANIMORA_STATE_RECEIVED_DEX) {
			setobjectxyperm(LOCALID_WATSONS_LAB_HARLEY, 14, 6)
		}
		end
	}
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_ANIMORA_CITY_STATE, 0 {
			playbgm(MUS_RG_OAK, TRUE)
			end
		}
		VAR_ANIMORA_CITY_STATE, ANIMORA_STATE_RECEIVED_DEX {
			turnobject(LOCALID_PLAYER, DIR_NORTH)
			end
		}
    ]
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_ANIMORA_CITY_STATE, 0 {
			lock
			applymovement(OBJ_EVENT_ID_PLAYER,        moves(walk_up * 4))
			applymovement(LOCALID_WATSONS_LAB_HARLEY, moves(walk_up * 4))
			waitmovement(0)
			applymovement(LOCALID_WATSONS_LAB_WATSON, moves(walk_in_place_down))
			waitmovement(0)
			msgbox(format("{COLOR BLUE}Prof. Watson{COLOR DARK_GRAY}: Ah, {PLAYER}! You finally made it!"))
			equestion(LOCALID_WATSONS_LAB_WATSON)
			msgbox(format("Hmm? Who's this you've got with you?"))
			applymovement(LOCALID_WATSONS_LAB_HARLEY, moves(walk_in_place_up))
			waitmovement(0)
			msgbox(format("{COLOR RED}Harley{COLOR DARK_GRAY}: The name's Harley. Nice to meet you, Professor."))
			
			// todo

			playfanfare(MUS_RG_OBTAIN_KEY_ITEM)
			message(format("{PLAYER} received the Pokédex!"))
