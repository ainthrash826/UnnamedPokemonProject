mapscripts RustboroCity_PokemonCenter_1F_MapScripts {
	MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script RustboroCity_PokemonCenter_1F_EventScript_Nurse {
	setvar(VAR_0x800B, LOCALID_RUSTBORO_NURSE)
	setvar(VAR_TEMP_A, FALSE)
	call(Common_EventScript_PkmnCenterNurse)
	waitmessage
	if(!var(VAR_TEMP_A)) {
		waitbuttonpress
	}
	turnobject(OBJ_EVENT_ID_PLAYER, DIR_SOUTH)
	release
	end
}

script RustboroCity_PokemonCenter_1F_EventScript_Man {
	msgbox(format("My Pokémon has a Naive nature, and my friend's has a Jolly nature.\p"
	              "It's fascinating how Pokémon have personalities!"), MSGBOX_NPC)
	end
}

script RustboroCity_PokemonCenter_1F_EventScript_Boy {
	msgbox(format("The man next door gave me an HM!\nI used it to teach my Pokémon how to Cut down skinny trees."), MSGBOX_NPC)
	end
}

script RustboroCity_PokemonCenter_1F_EventScript_Girl {
	msgbox(format("Just like people, there are male and female Pokémon.\p"
	              "Some Pokémon even have variations depending on their gender!"), MSGBOX_NPC)
	end
}
