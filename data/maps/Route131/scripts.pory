mapscripts Route131_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_VISITED_CENTRA_CITY)
		end
	}
	MAP_SCRIPT_ON_RESUME: Common_EventScript_RemoveStaticEncounter
}


// NPCs
script CentraSW_Wingull {
	lock
	faceplayer
	setwildbattle(SPECIES_WINGULL, 7)
	waitse
	playmoncry(SPECIES_WINGULL, CRY_MODE_NORMAL)
	waitmoncry
	setflag(FLAG_SYS_CTRL_OBJ_DELETE)
	dowildbattle
	clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
	setvar(VAR_TEMP_D, ITEM_PRETTY_FEATHER)
	call(StaticMonItemDropChance)
	release
	end
}

// Signs
script CentraCitySign_R3Gate {
	call(EventScript_BufferTime)
	msgbox("Centra City - Route 3 Gate, {STR_VAR_1}:{STR_VAR_2}{STR_VAR_3}\n"
	       "The Heart of the ??? Region\p"
	       "This city is separated into four\n"
	       "sections. You are currently located in\l"
	       "the Southwest section.", MSGBOX_SIGN)
}

script CentraCitySignBuffer_SW {
	bufferstring(STR_VAR_1, "Southwest")
	goto(CentraCitySign)
}

// Triggers

script CentraSWClassmateTrigger {
	goto_if_not_defeated(TRAINER_ROXANNE_1, Common_EventScript_BlockProgression)
	lock
	switch(getplayery) {
		case 1:
			setobjectxyperm(LOCALID_CENTRA_SW_AIDE, 8, 7)
		case 2:
			setobjectxyperm(LOCALID_CENTRA_SW_AIDE, 8, 8)
		case 3:
			setobjectxyperm(LOCALID_CENTRA_SW_AIDE, 8, 9)
	}
	addobject(LOCALID_CENTRA_SW_AIDE)
	applymovement(LOCALID_CENTRA_SW_AIDE, moves(walk_up * 6
									            walk_left * 2))
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_fast_right))
	waitmovement(0)
	msgbox(format("Hello, {PLAYER}! Glad I caught up to you.\p"
				  "I'm an Aide of Professor Watson's, here on his behalf to congratulate you for defeating the Southeast Centra Gym and obtaining your first Gym Badge!\p"
				  "I've also come to give you two things, first of which is this!"))
	playfanfare(MUS_RG_OBTAIN_KEY_ITEM)
	message(format("{PLAYER} received the DexNav!"))
	waitfanfare
	setflag(FLAG_SYS_DEXNAV_GET)
	setflag(FLAG_DEXNAV_DETECTOR_MODE)
	msgbox(format("The second thing I wanted to give you is this."))
	giveitem(ITEM_LETTER)
	msgbox(format("That Letter is from the Professor to a good friend of his in {COLOR GREEN}Olstern City{COLOR DARK_GRAY}, named {COLOR BLUE}Kane{COLOR DARK_GRAY}.\p"
	              "Some people refer to him as “Ol' Kane”, I believe.\p"
	              "Anyway, the Professor asked me to ask you to deliver it for him in hopes that you don't mind.\p"
				  "With that being said, both the Professor and I wish you the best of luck on your Pokémon journey, {PLAYER}!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_CENTRA_SW_AIDE, moves(walk_right * 2
									  walk_down * 10))
	waitmovement(0)
	removeobject(LOCALID_CENTRA_SW_AIDE)
	setvar(VAR_CENTRA_SW_STATE, CENTRA_SW_STATE_RECEIVED_LETTER_DEXNAV)
	release
	end
}

raw `
Route131_EventScript_Richard::
	trainerbattle_single TRAINER_RICHARD, Route131_Text_RichardIntro, Route131_Text_RichardDefeat
	msgbox Route131_Text_RichardPostBattle, MSGBOX_AUTOCLOSE
	end

Route131_EventScript_Herman::
	trainerbattle_single TRAINER_HERMAN, Route131_Text_HermanIntro, Route131_Text_HermanDefeat
