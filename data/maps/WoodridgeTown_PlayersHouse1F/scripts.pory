mapscripts WoodridgeTown_PlayersHouse1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setrespawn(HEAL_LOCATION_WOODRIDGE_TOWN)
	}
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_WOODRIDGE_TOWN_STATE, WOODRIDGE_STATE_POST_VWT_SUBZERO_ENCOUNTER {
			savebgm(MUS_NONE)
			turnobject(LOCALID_PLAYER, DIR_EAST)
		}
	]
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_WOODRIDGE_TOWN_STATE, WOODRIDGE_STATE_POST_VWT_SUBZERO_ENCOUNTER {
			lock
			delay(90)
			playse(SE_EXIT)
			addobject(LOCALID_PLAYERS_HOUSE_HARLEY)
			applymovement(LOCALID_PLAYERS_HOUSE_HARLEY, moves(walk_down * 3
			                                                  walk_left * 3
															  walk_down * 2
															  walk_in_place_fast_left))
			waitmovement(0)
			msgbox(format("{COLOR RED}Harley{COLOR DARK_GRAY}: Thanks again for letting me use your bedroom to change out of that God-awful uniform.\p"
			              "By the way, I never caught your name.\n"
			              "… … … … … … … …\l{PLAYER}, huh? Nice to meet you.\p"
						  "Look {PLAYER}, this might sound a bit silly, but I'm not actually apart of Subzero.\p"
						  "When I first heard of the group, I thought something was sketchy about it as a whole.\p"
						  "So, I decided to join it to try and single-handedly take Subzero down from the inside with help from my boyfriend, {COLOR BLUE}Leon{COLOR DARK_GRAY}.\p"
						  "Unfortunately for me, I haven't had the best of luck lately, and bringing {COLOR BLUE}Leon{COLOR DARK_GRAY} with me was an even bigger mistake than I anticipated.\p"
						  "Anyways, {PLAYER}, the bottom line is Subzero is planning something big and presumably dangerous.\p"
						  "But for some reason, everyone I've asked about Subzero seems to be oblivious to the fact that it even exists!\p"
				          "Who could I possibly go to about this around here…?"), MSGBOX_AUTOCLOSE)
			delay(120)
			exclam(LOCALID_PLAYERS_HOUSE_HARLEY)
			applymovement(LOCALID_PLAYERS_HOUSE_HARLEY, moves(walk_in_place_left))
			waitmovement(0)
			msgbox(format("{COLOR RED}Harley{COLOR DARK_GRAY}: Wait a minute. {COLOR GREEN}Animora City{COLOR DARK_GRAY}'s home to Pokémon Professor {COLOR BLUE}Watson{COLOR DARK_GRAY}!\p"
			              "He'll certainly have some knowledge about Subzero, or would like to hear about it at the very least.\p"
						  "Alright, it's set, {PLAYER}.\n"
						  "We're going to {COLOR GREEN}Animora City{COLOR DARK_GRAY} to speak to the Professor!\p"
						  "Oh! Speaking of, {PLAYER}, I want you to have this!"))
			giveitem(ITEM_POTION)
			msgbox(format("Wild Pokémon may attack you in the tall grass on your way to {COLOR GREEN}Animora{COLOR DARK_GRAY}.\p"
			              "If your Pokémon gets hurt, use that spray on it to heal it up.\p"
						  "Alright, I'm gonna get a head-start.\nI'll meet you in {COLOR GREEN}Animora{COLOR DARK_GRAY}, {PLAYER}!"), MSGBOX_AUTOCLOSE)
			applymovement(LOCALID_PLAYERS_HOUSE_HARLEY, moves(walk_fast_down
															  walk_fast_right * 3
			                                                  walk_in_place_down))
			waitmovement(0)
			playse(SE_EXIT)
			removeobject(LOCALID_PLAYERS_HOUSE_HARLEY)
			setflag(FLAG_ADVENTURE_STARTED)
			clearflag(FLAG_HIDE_MAP_NAME_POPUP)
			clearflag(FLAG_HIDE_WOODRIDGE_TOWN_FAT_MAN)
			setvar(VAR_ROUTE1_STATE, R1_STATE_ENTRY_ALLOWED)
			setvar(VAR_WOODRIDGE_TOWN_STATE, WOODRIDGE_STATE_ADVENTURE_BEGIN)
			waitse
			playbgm(MUS_LITTLEROOT, TRUE)
			release
			end
		}
    ]
}