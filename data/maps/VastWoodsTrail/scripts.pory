mapscripts VastWoodsTrail_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_VAST_WOODS_TRAIL_STATE) < VWT_STATE_CHOOSING_STARTER) {
            setvar(VAR_TEMP_8, TRUE)
        }
        end
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_VAST_WOODS_TRAIL_STATE, VWT_STATE_POST_BATTLE: Common_EventScript_BlockProgression
    ]
    MAP_SCRIPT_ON_RESUME {
        if(var(VAR_VAST_WOODS_TRAIL_STATE) == VWT_STATE_SUBZERO_BATTLE) {
            switch(var(VAR_RESULT)) {
                case B_OUTCOME_WON:
                    playbgm(MUS_ENCOUNTER_MAGMA, FALSE)
                case B_OUTCOME_LOST:
                    playbgm(MUS_NONE, TRUE)
            }
        }
        end
    }
}

// Signs

script VastWoodsTrailSign {
    msgbox(format("Vast Woods Trail\n"
                  "{LEFT_ARROW}Woodridge Town\l{RIGHT_ARROW}Vast Woods"), MSGBOX_SIGN)
    end
}
script VastWoodsSign {
    msgbox(format("Vast Woods"), MSGBOX_SIGN)
    end
}

// Triggers

script VwtTrigger1 {
    lock
    if(!var(VAR_VAST_WOODS_TRAIL_STATE)) {
         playbgm(MUS_NONE, TRUE)
         playmoncry(SPECIES_SNIVY, CRY_MODE_ENCOUNTER)
         delay(20)
         playmoncry(SPECIES_FUECOCO, CRY_MODE_ENCOUNTER)
         delay(20)
         playmoncry(SPECIES_FROAKIE, CRY_MODE_ENCOUNTER)
         delay(20)
         applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_fast_right
                                                  delay_16
                                                  delay_4
                                                  walk_in_place_fast_left
                                                  delay_16
                                                  delay_4
                                                  walk_in_place_fast_down
                                                  emote_exclamation_mark
                                                  delay_16 * 2))
         delay(64)
         playse(SE_PIN)
         waitmovement(0)
         setvar(VAR_VAST_WOODS_TRAIL_STATE, VWT_STATE_HEARD_MON_CRIES)
    } else {
        msgbox(format("You've got to keep going!\nWhatever made those noises might be in trouble!"), MSGBOX_AUTOCLOSE)
        applymovement(OBJ_EVENT_ID_PLAYER, moves(player_run_down))
        waitmovement(0)
    }
    release
    end
}

script VwtSubzeroEncounter {
    lock
    playbgm(MUS_NONE, FALSE)
    playmoncry(SPECIES_SNIVY, CRY_MODE_NORMAL)
    delay(16)
    playmoncry(SPECIES_FUECOCO, CRY_MODE_NORMAL)
    delay(16)
    playmoncry(SPECIES_FROAKIE, CRY_MODE_NORMAL)
    msgbox(format("Huh? Whose Pokémon are these?"), MSGBOX_AUTOCLOSE)
    delay(60)
    msgbox(format("Hey, you!\nDon't move!"))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right
                                             emote_exclamation_mark))
    waitmovement(0)
    playse(SE_PIN)
    closemessage
    playbgm(MUS_ENCOUNTER_MAGMA, TRUE)
    switch(getplayery) {
        case 24:
            applymovement(LOCALID_VWT_LEON, moves(walk_left * 6))
            applymovement(LOCALID_VWT_HARLEY, moves(delay_16
                                                walk_left * 5))
            applymovement(LOCALID_VWT_GRANT, moves(delay_16 * 2
                                               walk_left * 3
                                               walk_up
                                               walk_left * 3))
        case 25:
            applymovement(LOCALID_VWT_LEON, moves(walk_left * 3
                                               walk_up
                                               walk_left * 3))
            applymovement(LOCALID_VWT_HARLEY, moves(delay_16
                                               walk_left * 3
                                               walk_up
                                               walk_left * 2))
            applymovement(LOCALID_VWT_GRANT, moves(delay_16 * 2
                                                walk_left * 6))
    }
    waitmovement(LOCALID_VWT_HARLEY)
    delay(30)
    applymovement(LOCALID_VWT_LEON, moves(walk_in_place_left))
    waitmovement(0)
    //todo
    msgbox(format("{COLOR RED}Harley{COLOR DARK_GRAY}: Hey. The name's Harley.\nBut no time for introductions!\p"
                  "Choose one of these Pokémon to battle with! I'll choose after you!"), MSGBOX_AUTOCLOSE)
    setvar(VAR_VAST_WOODS_TRAIL_STATE, VWT_STATE_CHOOSING_STARTER)
    fadescreen(FADE_TO_BLACK)
    special(ChooseStarter)
    switch(var(VAR_STARTER_MON)) {
        case 0:
            bufferspeciesname(STR_VAR_1, SPECIES_SNIVY)
        case 1:
            bufferspeciesname(STR_VAR_1, SPECIES_FROAKIE)
        case 2:
            bufferspeciesname(STR_VAR_1, SPECIES_FUECOCO)
    }
    msgbox("{COLOR RED}Harley{COLOR DARK_GRAY}: Alright, then I choose you,\n{STR_VAR_1}!", MSGBOX_AUTOCLOSE)
    msgbox(format("{COLOR RED}Harley{COLOR DARK_GRAY}: You obviously chose Subzero over me. What else am I supposed to do?\p"
                  "Did you forget why we joined this group in the first place?"))
    setvar(VAR_VAST_WOODS_TRAIL_STATE, VWT_STATE_SUBZERO_BATTLE)
    setflag(FLAG_NO_WHITEOUT)
    switch (var(VAR_STARTER_MON)) {
        case 0: // Fuecoco: Harley Snivy, Watson Froakie
            setseenmon(SPECIES_FROAKIE)
            multi_fixed_2_vs_2(TRAINER_MAXIE_MOSSDEEP, format("What!? How?"),
                                TRAINER_TABITHA_MOSSDEEP, format("The Boss isn't gonna be happy to hear this…"),
                                PARTNER_VWT_HARLEY_GRASS)
        case 1: // Snivy: Harley Froakie, Watson Fuecoco 
            setseenmon(SPECIES_FUECOCO)
            multi_fixed_2_vs_2(TRAINER_MAXIE_MOSSDEEP, format("What!? How?"),
                                TRAINER_TABITHA_MOSSDEEP, format("The Boss isn't gonna be happy to hear this…"),
                                PARTNER_VWT_HARLEY_WATER)
        case 2: // Froakie: Harley Fuecoco, Watson Snivy
            setseenmon(SPECIES_SNIVY)
            multi_fixed_2_vs_2(TRAINER_MAXIE_MOSSDEEP, format("What!? How?"),
                                TRAINER_TABITHA_MOSSDEEP, format("The Boss isn't gonna be happy to hear this…"),
                                PARTNER_VWT_HARLEY_FIRE)
    }
    switch (var(VAR_RESULT)) {
        case B_OUTCOME_WON:
            settrainerflag(TRAINER_MAXIE_MOSSDEEP)
            settrainerflag(TRAINER_TABITHA_MOSSDEEP)
        case B_OUTCOME_LOST:
            setflag(FLAG_LOST_FIRST_BATTLE)
    }
    special(HealPlayerParty)
    setflag(FLAG_HIDE_MAP_NAME_POPUP)
    setflag(FLAG_HIDE_NPCS_VAST_WOODS_TRAIL)
    clearflag(FLAG_NO_WHITEOUT)
    clearflag(FLAG_HIDE_WOODRIDGE_TOWN_HARLEY)
    setvar(VAR_VAST_WOODS_TRAIL_STATE, VWT_STATE_POST_BATTLE)
    setvar(VAR_WOODRIDGE_TOWN_STATE, WOODRIDGE_STATE_POST_VWT_SUBZERO_ENCOUNTER)
    warpsilent(MAP_WOODRIDGE_TOWN, 30, 20)
    waitstate
    release
    end
}