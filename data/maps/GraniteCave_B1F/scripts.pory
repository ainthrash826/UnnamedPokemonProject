// NPCs

script GraniteCave_B1F_EventScript_Hiker {
	if(var(VAR_UMN_CAVE_STATE) < UMN_CAVE_STATE_CAVE_IN_CLEARED) {
		if(!flag(FLAG_TALKED_TO_DETONATOR)) {
			msgbox(format("Zzz zzz…\nZzz zzz…\p"
						  "Whuh?\nOh, hey there.\p"
						  "This part of the cave leads to the southern portion of Route 3. Unfortunately, it's been blocked off by a cave-in, so you'll have to find some way around it.\p"
						  "Jeez, what time is it? My crew was supposed to be here hours ago with the dynamite to blast this thing!\p"
						  "Come to think of it, I did see a group of weird-lookin' people with some equipment some time ago…\p"
						  "Hey, you. If you happen to to run into some weird-lookin' people, ask them if they have any spare dynamite on them."), MSGBOX_NPC)
			setflag(FLAG_TALKED_TO_DETONATOR)
		} else {
			msgbox(format("This part of the cave leads to the southern portion of Route 3. Unfortunately, it's been blocked off by a cave-in, so you'll have to find some way around it.\p"
						  "Jeez, what time is it? My crew was supposed to be here hours ago with the dynamite to blast this thing!\p"
						  "Come to think of it, I did see a group of weird-lookin' people with some equipment some time ago…\p"
						  "If you happen to to run into some weird-lookin' people, ask them if they have any spare dynamite on them."), MSGBOX_NPC)
		}
	} else {
		if(!flag(FLAG_TALKED_TO_DETONATOR)) {
			msgbox(format("Hahah! Hey there kid!\nYou totally missed it! Me n' my crew just blasted the cave-in here!\p"
						  "It was as if a bunch of fireworks were going off inside a dust devil.\p"
						  "It was so awesome! Hahaha!"), MSGBOX_NPC)
			setflag(FLAG_TALKED_TO_DETONATOR)
		} else {
			msgbox(format("The cave-in's been cleared. Now you can use this way to get to Olstern City."), MSGBOX_NPC)
		}
	}
	end
}

// Trainers

script UnmCaveB1FHenry {
	trainerbattle_single(TRAINER_HENRY,
	                     format("Welcome to ??? Cave.\nTry not to get lost!"),
						 format("Actually, getting lost here is easier said than done…"))
	msgbox(format("I hitchhiked here all the way from ??? Town.\lBoy, what a journey's it's been!"), MSGBOX_NPC)
	end
}

