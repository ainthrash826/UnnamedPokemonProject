const FLAG_TALKED_TO_DETONATOR = FLAG_TEMP_1

mapscripts GraniteCave_B1F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if(!var(VAR_COALESCE_CAVE_STATE)) {
			setobjectxyperm(LOCALID_COALESCE_CAVE_GRANT, 7, 45)
		}
		if(var(VAR_COALESCE_CAVE_STATE) < COALESCE_CAVE_STATE_CAVE_IN_CLEARED) {
			setobjectxyperm(LOCALID_COALESCE_CAVE_DETONATOR, 25, 62)
			setobjectmovementtype(LOCALID_COALESCE_CAVE_DETONATOR, MOVEMENT_TYPE_FACE_DOWN)
		}
	}
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_COALESCE_CAVE_STATE, COALESCE_CAVE_STATE_CAVE_IN_CLEARED: ClearCaveIn
	]
}

