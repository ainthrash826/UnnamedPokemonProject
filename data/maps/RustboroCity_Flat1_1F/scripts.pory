mapscripts RustboroCity_Flat1_1F_MapScripts {}

script RustboroCity_Flat1_1F_EventScript_Woman {
	msgbox(format("I was on vacation in another region last month, and a butterfly Pokémon flew up to me and told me possibly the funniest joke I've heard all year.\p"
				  "Pokémon are such strange creatures."), MSGBOX_NPC)
	end
}

script RustboroCity_Flat1_1F_EventScript_Man {
	msgbox(format("Have you visited the Centra Berry Shop lately?\p"
				  "I heard that the ladies who run the shop have to work exceptionally hard to get the Berries they sell.\p"
				  "It is the only place in the region to sell Berries, after all!"), MSGBOX_NPC)
	end
}

script CentraFlat1_1F_Thief {
	if(!checkitem(ITEM_TM_THIEF)) {
		lock
		faceplayer
		msgbox(format("Boy, do I sure love being a Thief!\p"
		              "I don't do it alone, though.\n"
		              "I usually rely on this baby!"))
		if(!giveitem(ITEM_TM_THIEF)) {
			goto(Common_EventScript_ShowBagIsFull)
		}
		msgbox(format("With the Thief move, you can steal the target's held item while dealing damamge to it!\p"
					  "It won't work if the user is already holding something, though."), MSGBOX_NPC)
		release
	} else {
		msgbox(format("With the Thief move, you can steal the target's held item while dealing damamge to it!\p"
				      "It won't work if the user is already holding something, though."), MSGBOX_NPC)

	}
	end
}