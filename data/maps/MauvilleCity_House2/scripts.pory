const LOCALID_SCIENTIST = 1
const LOCALID_ORION = 2
const LOCALID_MAN = 3
const LOCALID_PIRATE1 = 4
const LOCALID_PIRATE2 = 5

mapscripts MauvilleCity_House2_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_OLSTERN_CITY_STATE, OLSTERN_STATE_KIDNAPPED {
			lock
			special(SpawnCameraObject)
			setobjectxy(OBJ_EVENT_ID_PLAYER, 3, 8)
			//TODO
			playbgm(MUS_HELP, TRUE)
			setflag(FLAG_DONT_TRANSITION_MUSIC)
			//clearflag(FLAG_HIDE_CUTSCENE_NPCS_OLSTERN_CITY_1)
			clearflag(FLAG_HIDE_CUTSCENE_NPCS_OLSTERN_CITY_2)
			warpsilent(MAP_MAUVILLE_CITY, 31, 8)
			waitstate
			release
			end
		}
	]
}