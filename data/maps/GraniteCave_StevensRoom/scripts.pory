// LocalIds
const LOCALID_GRUNT1 = 1
const LOCALID_ADMIN = 2
const LOCALID_ROTOM = 3

// Others
const COORD_X  = VAR_TEMP_0
const COORD_Y  = VAR_TEMP_1

mapscripts GraniteCave_StevensRoom_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_LANDMARK_OLD_IRONWORKS)
		if(!var(VAR_NEW_MAUVILLE_STATE)) {
			setobjectmovementtype(LOCALID_ROTOM, MOVEMENT_TYPE_WALK_IN_PLACE_DOWN)
		}
	}
}

script OldIronworksSubzeroEncounter {
	lock
	special(SpawnCameraObject)
	getplayerxy(COORD_X, COORD_Y)
	switch(var(COORD_X)) {
		case 13:
		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_diag_southwest * 3
												 walk_down * 2))
		case 14:
		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_diag_southwest * 4
												 walk_down))
		case 15:
		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_diag_southwest * 5))
	}
	waitmovement(0)
	playmoncry(SPECIES_ROTOM, CRY_MODE_WEAK)
	waitmoncry
	exclam(LOCALID_ADMIN)
	applymovement(LOCALID_ADMIN, moves(walk_in_place_fast_down * 3))
	waitmovement(0)
	msgbox(format("???: Gah! Have you ever heard of a Rotom that can't enter an appliance!?\p"
				  "No worries. We aleady got what we needed from this old dump. This Rotom's just a minor fork in the road."))
	applymovement(LOCALID_ADMIN, moves(walk_in_place_fast_right))
	applymovement(LOCALID_GRUNT1, moves(walk_in_place_fast_left))
	waitmovement(0)
	msgbox(format("???: Let the other Grunts in ??? Cave know we're regrouping on Route 5.\pWe're done here."))
	applymovement(LOCALID_GRUNT1, moves(walk_in_place_fast_left))
	waitmovement(0)
	msgbox(format("Grunt: Copy!"), MSGBOX_AUTOCLOSE)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right * 4))
	applymovement(LOCALID_GRUNT1, moves(walk_in_place_fast_right
										delay_8
										walk_right * 3
										walk_in_place_fast_up))
	waitmovement(0)
	exclam(LOCALID_GRUNT1)
	msgbox(format("Grunt: Uh oh!\nIntruder alert!"), MSGBOX_AUTOCLOSE)
	switch(var(COORD_X)) {
		case 13:
		applymovement(LOCALID_GRUNT1, moves(walk_fast_up * 2
												 walk_fast_left
												 walk_fast_up * 2))
		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_up * 2
												 walk_fast_left
												 walk_fast_up * 3))
		case 14:
		applymovement(LOCALID_GRUNT1, moves(walk_fast_up * 4))
		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_up * 5))
		case 15:
		applymovement(LOCALID_GRUNT1, moves(walk_fast_up * 2
												 walk_fast_right
												 walk_fast_up * 2))
		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_up * 2
												 walk_fast_right
												 walk_fast_up * 3))

	}
	waitmovement(0)
	playbgm(MUS_ENCOUNTER_MAGMA, TRUE)
	msgbox(format(""))
	trainerbattle_no_intro(TRAINER_GRUNT_SEAFLOOR_CAVERN_1, format(""))
	removeobject(LOCALID_GRUNT1)
	msgbox(format(""))
