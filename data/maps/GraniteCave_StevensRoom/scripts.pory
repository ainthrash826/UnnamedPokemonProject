script(local) ReceiveRotom {
	setflag(FLAG_RECEIVED_ROTOM_OLD_IRONWORKS)
	bufferspeciesname(STR_VAR_2, SPECIES_ROTOM)
	playfanfare(MUS_OBTAIN_ITEM)
	message(format("{PLAYER} obtained the left-behind Rotom!"))
	waitmessage
	waitfanfare
	bufferspeciesname(STR_VAR_1, SPECIES_ROTOM)
	msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
}

script OldIronworksRotomMain {
	playmoncry(SPECIES_ROTOM, CRY_MODE_DOUBLES)
	waitmoncry
	delay(8)
	msgbox(format("It's the Rotom Subzero left behind…\n"
	              "It's even got its Poké Ball, too.\p"
	              "It seems it wants to tag along with you.\p"
				  "Take the Rotom?"), MSGBOX_YESNO)
	if(var(VAR_RESULT)) {
		setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_ROTOM)
		switch (givemon(SPECIES_ROTOM, 15)) {
			case MON_GIVEN_TO_PARTY:
				call(ReceiveRotom)
				if(var(VAR_RESULT)) {
					call(Common_EventScript_GetGiftMonPartySlot)
					call(Common_EventScript_NameReceivedPartyMon)
				}
				playse(SE_BALL_OPEN)
				applymovement(LOCALID_ROTOM, moves(enter_pokeball))
				waitse
				removeobject(LOCALID_ROTOM)
				msgbox("{STR_VAR_2} was added to your party.")
			case MON_GIVEN_TO_PC:
				call(ReceiveRotom)
				if(var(VAR_RESULT)) {
					call(Common_EventScript_NameReceivedBoxMon)
				}
				playse(SE_BALL_OPEN)
				applymovement(LOCALID_ROTOM, moves(enter_pokeball))
				waitse
				removeobject(LOCALID_ROTOM)
				msgbox("{STR_VAR_2} was sent to your Boxes.")
			case MON_CANT_GIVE:
				msgbox(format("You have no more room for Pokémon! The Pokémon Boxes are full and can't accept any more!"), MSGBOX_SIGN)
		}
	} else {
		msgbox(format("{PLAYER} let the Rotom be."), MSGBOX_NPC)
	}
}

script OldIronworksRotom {
	lock
	faceplayer
	call(OldIronworksRotomMain)
	release
	end
}
