mapscripts SlateportCity_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_VISITED_CENTRA_CITY)
		end
	}
}

text HarleyDefeat1 {
	format("Wow, you really are a natural!")
}

// NPCs

const CENTRA_SE_GYM_GUIDE_PISSED = 3

script CentraSEGymGuideOutside {
	if(var(VAR_TEMP_3) > CENTRA_SE_GYM_GUIDE_PISSED) {
		msgbox(format("For the last time, she's not here.\nNow get lost!"), MSGBOX_NPC)
	} else {
		msgbox(format("Hey, Trainer! Lookin' to challenge the Gym Leader?\p"
					  "Well sorry to say, but she's not here at the moment!"), MSGBOX_NPC)
		addvar(VAR_TEMP_3, 1)
	}
	end
}

// Signs

script CentraCitySign_R2Gate {
	call(EventScript_BufferTime)
	msgbox("Centra City - Route 2 Gate, {STR_VAR_1}:{STR_VAR_2}{STR_VAR_3}\n"
	       "The Heart of the ??? Region\p"
	       "This city is separated into four\n"
	       "sections. You are currently located in\l"
	       "the Southeast section.", MSGBOX_SIGN)
}

script CentraCitySignBuffer_SE {
	bufferstring(STR_VAR_1, "Southeast")
	goto(CentraCitySign)
}

script CentraCitySign {
	msgbox("Centra City\nThe Heart of the ??? Region\p"
		   "This city is separated into four\nsections. You are currently located in\lthe {STR_VAR_1} section.", MSGBOX_SIGN)
	call(EventScript_BufferTime)
	msgbox("Current Time: {STR_VAR_1}:{STR_VAR_2}{STR_VAR_3}", MSGBOX_SIGN)
	end
}

script CentraSE_BerryShopSign {
	msgbox("Centra City Berry Shop", MSGBOX_SIGN)
	end
}

script CentraSEGymSign {
	msgbox(format("Southeast Centra Pokémon Gym\nLeader: Aria\l"
		          "The ????????????!"), MSGBOX_SIGN)
	end
}

