mapscripts WoodridgeTown_MapScripts {
	MAP_SCRIPT_ON_LOAD {
		if(!flag(FLAG_IS_CHAMPION)) {
			setmetatile(4, 2, 0x1DE, TRUE)
			setmetatile(5, 2, 0x1DF, TRUE)
			setmetatile(6, 2, 0x1DE, TRUE)
			setmetatile(7, 2, 0x1DF, TRUE)
			
			setmetatile(4, 3, 0x1D6, TRUE)
			setmetatile(5, 3, 0x1D7, TRUE)
			setmetatile(6, 3, 0x1D6, TRUE)
			setmetatile(7, 3, 0x1D7, TRUE)
			
			setmetatile(4, 4, 0x1DE, TRUE)
			setmetatile(5, 4, 0x1DF, TRUE)
			setmetatile(6, 4, 0x1DE, TRUE)
			setmetatile(7, 4, 0x1DF, TRUE)
			
			setmetatile(4, 5, 0x1D6, TRUE)
			setmetatile(5, 5, 0x1D7, TRUE)
			setmetatile(6, 5, 0x1D6, TRUE)
			setmetatile(7, 5, 0x1D7, TRUE)
			setmetatile(8, 5, 0x1D6, TRUE)
			setmetatile(9, 5, 0x1D7, TRUE)
			
			setmetatile(4, 6, 0x1DE, TRUE)
			setmetatile(5, 6, 0x1DF, TRUE)
			setmetatile(6, 6, 0x1DE, TRUE)
			setmetatile(7, 6, 0x1DF, TRUE)
			setmetatile(8, 6, 0x1E6, TRUE)
			setmetatile(9, 6, 0x1E7, TRUE)

			setmetatile(4, 7, 0x1D6, TRUE)
			setmetatile(5, 7, 0x1D7, TRUE)
			setmetatile(6, 7, 0x001, FALSE)

			setmetatile(4, 8, 0x1E6, TRUE)
			setmetatile(5, 8, 0x1E7, TRUE)
			setmetatile(6, 8, 0x001, FALSE)
		}
	}

	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_VISITED_WOODRIDGE_TOWN)
		end
	}
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_WOODRIDGE_TOWN_STATE, WOODRIDGE_STATE_POST_VWT_SUBZERO_ENCOUNTER {
			savebgm(MUS_NONE)
			hideobjectat(LOCALID_PLAYER, MAP_WOODRIDGE_TOWN)
		}
	]
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_WOODRIDGE_TOWN_STATE, WOODRIDGE_STATE_POST_VWT_SUBZERO_ENCOUNTER {
			lock
			special(SpawnCameraObject)
			addobject(LOCALID_WOODRIDGE_HARLEY)
			getobjectxy(LOCALID_WOODRIDGE_HARLEY, CURRENT_POSITION, VAR_TEMP_0, VAR_TEMP_1)
			subvar(VAR_TEMP_0, 1)
			setobjectxy(LOCALID_PLAYER, VAR_TEMP_0, VAR_TEMP_1)
			applymovement(LOCALID_PLAYER, moves(set_visible
				                                player_run_up * 3
			                                    walk_up * 3
												delay_16 * 3
												walk_in_place_fast_right))
			applymovement(LOCALID_WOODRIDGE_HARLEY, moves(walk_fast_up * 3
			                                              walk_up * 3
														  delay_16 * 2
												          walk_in_place_fast_left))
			waitmovement(0)
			msgbox(format("Do you have somewhere for us to hideout so I can talk about what's going on?\p"
			              "… … You have a house in {COLOR GREEN}Woodridge{COLOR DARK_GRAY}?\nLucky bastard. My dad's been trying to move out here for years!\lAnyways…\p"
						  "Let's go to your house for the time being."), MSGBOX_AUTOCLOSE)
			applymovement(LOCALID_PLAYER, moves(walk_up * 6))
			applymovement(LOCALID_WOODRIDGE_HARLEY, moves(walk_up * 6))
			delay(48)
			fadescreen(FADE_TO_BLACK)
			waitmovement(0)
			removeobject(LOCALID_WOODRIDGE_HARLEY)
			warpnofade(MAP_WOODRIDGE_TOWN_PLAYERS_HOUSE1F, 2, 7)
			waitstate
			release
			end
			//switch (var(VAR_STARTER_MON)) {
			//	case 0:
			//		trainerbattle_no_intro(TRAINER_BRENDAN_ROUTE_103_TORCHIC, format("é"))
			//	case 1:
			//		trainerbattle_no_intro(TRAINER_BRENDAN_ROUTE_103_TREECKO, format("é"))
			//	case 2:
			//		trainerbattle_no_intro(TRAINER_BRENDAN_ROUTE_103_MUDKIP, format("é"))
			//}
			//if(defeated(TRAINER_BRENDAN_ROUTE_103_TREECKO)
			//|| defeated(TRAINER_BRENDAN_ROUTE_103_TORCHIC)
			//|| defeated(TRAINER_BRENDAN_ROUTE_103_MUDKIP)) {
			//		msgbox(format("TRUE"), MSGBOX_AUTOCLOSE)
			//} else {
			//		msgbox(format("FALSE"), MSGBOX_AUTOCLOSE)
            //
			//}
			//special(HealPlayerParty)
		}
	]
}

// NPCs

script WoodridgeTownFatMan {
	msgbox(format("Technology is incredible!"), MSGBOX_NPC)
	end
}

// Signs

script WoodridgeTownSign {
	call(EventScript_BufferTime)
	msgbox("Woodridge Town, {STR_VAR_1}:{STR_VAR_2}{STR_VAR_3}", MSGBOX_SIGN)
	end
}

script PlayersHouseSign {
	msgbox("{PLAYER}'s House", MSGBOX_SIGN)
	end
}