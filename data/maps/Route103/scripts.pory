}

script Route3CoupleF {
	trainerbattle_double(TRAINER_MARCOS, format("I'm on a date with my boyfriend."), 
	                                     format(""),
										 format("I'm on a date with my boyfriend.\n"
										        "We'd love to battle, but it seems you don't have enough Pokémon to do so…"))
	msgbox(format("Between you and me, our battle with you made this date a lot better.\lThank you."), MSGBOX_NPC)
	end
}

// Triggers 

script Route3HarleyTrigger {
	lock
	message(format("???: {PLAYER}!"))
	waitmessage
	delay(8)
	exclam(LOCALID_PLAYER)
	applymovement(LOCALID_PLAYER, moves(walk_in_place_fast_right))
	addobject(LOCALID_R3_HARLEY)
	switch(getplayery) {
		case 32:
			applymovement(LOCALID_R3_HARLEY, moves(walk_left * 7))
		case 33:
			applymovement(LOCALID_R3_HARLEY, moves(walk_left * 4
												   walk_down
												   walk_left * 3))
		case 34:
			applymovement(LOCALID_R3_HARLEY, moves(walk_left * 2
												   walk_down
												   walk_left * 2
												   walk_down
												   walk_left * 3))
	}
	delay(30)
	closemessage
	waitmovement(0)
	// todo
	playbgm(MUS_ENCOUNTER_MAY, FALSE)
	msgbox(format("{COLOR RED}Harley{COLOR DARK_GRAY}: You know what time it is, {PLAYER}.\p"
	              "It's battle time!"))
	switch(var(VAR_STARTER_MON)) {
		case 0:
			trainerbattle_no_intro(TRAINER_MAY_ROUTE_103_TORCHIC, Route3HarleyDefeat)
		case 1:
			trainerbattle_no_intro(TRAINER_MAY_ROUTE_103_TREECKO, Route3HarleyDefeat)
		case 2:
			trainerbattle_no_intro(TRAINER_MAY_ROUTE_103_MUDKIP, Route3HarleyDefeat)
	}
	msgbox(format("{COLOR RED}Harley{COLOR DARK_GRAY}: What an awesome battle, {PLAYER}!\p"
	              "Now let me heal your team real quick."), MSGBOX_AUTOCLOSE)
	playse(SE_USE_ITEM)
	waitse
	special(HealPlayerParty)
	msgbox(format("{COLOR RED}Harley{COLOR DARK_GRAY}: I'm going to wait a while before heading into ??? Cave.\p"
	              "I'll catch you around, {PLAYER}!"), MSGBOX_AUTOCLOSE)
	applymovement(LOCALID_R3_HARLEY, moves(walk_right * 10))
	waitmovement(0)
	removeobject(LOCALID_R3_HARLEY)
	setvar(VAR_ROUTE3_STATE, R3_STATE_HARLEY_DEFEATED)
	release
	end
}

text Route3HarleyDefeat {
	format("Huh… Guess you win.")
}