	msgbox("Route 3 “???”, {STR_VAR_1}:{STR_VAR_2}{STR_VAR_3}\n"
	       "{LEFT_ARROW} ??? Town, Olstern City", MSGBOX_SIGN)
	end
}

script Route3EastSign2 {
	call(EventScript_BufferTime)
	msgbox("Route 3 - ??? Cave, {STR_VAR_1}:{STR_VAR_2}{STR_VAR_3}\p"
	       "Centra City {RIGHT_ARROW}", MSGBOX_SIGN)
	end
}

// NPCs

script Route3Boy {
	msgbox("My Pokémon is staggeringly tired…\nI should have brought a Potion…", MSGBOX_NPC)
	end
}

script Route3Man {
	msgbox(format("The ??? Cave is up ahead.\nGood thing it isn't dark enough that you'd need Flash to navigate through it.\p"
	              "Imagine how inconvenient that would've been!"), MSGBOX_NPC)
	end
}

script Route3Girl {
	lock
	faceplayer
	if(!flag(FLAG_RECEIVED_BRIGHT_POWDER)) {
		msgbox(format("Are you playing Hide-and-Seek, too?"), MSGBOX_YESNO)
		if(var(VAR_RESULT)) {
			bufferstring(STR_VAR_1, "you don't look like\nyou're hiding!\p")
		} else {
			bufferstring(STR_VAR_1, "I can tell!\n")
		}
		msgbox("Teehee, {STR_VAR_1}"
			   "Take this, it'll help!")
		if(!giveitem(ITEM_BRIGHT_POWDER)) {
			goto(Common_EventScript_ShowBagIsFull)
		}
		setflag(FLAG_RECEIVED_BRIGHT_POWDER)
	}
	msgbox(format("That's a Bright Powder! It emits a tricky glare that lowers the opposing Pokémon's accuracy.\p"
	              "In other words…\nIt's the ultimate hiding tool! Teehee!"), MSGBOX_NPC)
	release
	end
}

script Route3Checkpoint {
	lock
	faceplayer
	if(!flag(FLAG_TEMP_1)) {
		msgbox(format("You look like you traveled a long way to get here, young Trainer.\pWhy not rest up a bit?"))
		closemessage
		playse(SE_USE_ITEM)
		special(HealPlayerParty)
		waitse
		setflag(FLAG_TEMP_1)
	}
	msgbox(format("There, now you all look refreshed.\nTake care!"), MSGBOX_NPC)
	release
	end
}

