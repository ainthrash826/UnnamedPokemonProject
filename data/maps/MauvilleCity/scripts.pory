text OrionDefeat2 {
	"Aw, man.\nYou're pretty tough, {PLAYER}!"
}

// NPCs

script OlsternTriathlete {
	msgbox(format("I can run around this perimeter forever because the sea breeze here is so refreshing!"), MSGBOX_NPC)
	end
}
script OlsternR4Roadblock {
	msgbox(format("Reno Boardwalk is currently undergoing construction, so we can't allow anyone through the route.\p"
		          "The good news is we're wrapping up construction now, so it won't take long for the route to reopen."), MSGBOX_NPC)
	end
}

script OlsternMan {
	if(var(VAR_OLSTERN_CITY_STATE) < OLSTERN_STATE_TAMMY_ENCOUNTER_END) {
		if(!flag(FLAG_TEMP_1)) {
			setflag(FLAG_TEMP_1)
			msgbox(format("Huh? I never saw you walk into the Abandoned Factory…\p"
					      "Were you with those two weird-lookin' dudes that just ran outta there?\p"
					      "Anyway, If you're heading into the city, some crazy lady is giving a speech or something up ahead.\p"
					      "I can't really tell what about, but not a lot of people seem to be interested in what she's gotta say."), MSGBOX_NPC)
		} else {
			msgbox(format("If you're heading into the city, some crazy lady is giving a speech or something up ahead.\p"
					      "I can't really tell what about, but not a lot of people seem to be interested in what she's gotta say."), MSGBOX_NPC)
		}
	} else {
		msgbox(format("Up ahead is the now abandoned Fuego Ironworks branch."), MSGBOX_NPC)
	}
	end
}

script OlsternBoatGuard {
	msgbox("Get lost, matey.\nThis 'ere vessel's for the adults!", MSGBOX_NPC)
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	end
}

script OlsternBeachDowsingMachine {
	lock
	faceplayer
	if(!checkitem(ITEM_DOWSING_MACHINE)) {
		msgbox("Psssst!\nDo you know what I'm doing?", MSGBOX_YESNO)
		if(!var(VAR_RESULT)) {
			msgbox(format("I'm using my Dowsing Machine to look for hidden items along the beach.\p"
			              "I'm not having any luck, though. Maybe you will?"))
			if(!giveitem(ITEM_DOWSING_MACHINE)) {
				goto(Common_EventScript_ShowBagIsFull)
			}
			msgbox(format("If you wear those, you'll be able to detect hidden items on the ground.\p"
			              "When you're directly facing an item, they'll light up red.\p"
						  "You can't run or sneak while using them, though."), MSGBOX_NPC)
		} else {
			msgbox("That's right!\nIt's hard work!", MSGBOX_NPC)
		}
	} else {
		msgbox(format("Slip the Dowsing Machine on, and you'll be able to detect hidden items on the ground.\p"
					  "When you're directly facing an item, it'll light up red.\p"
					  "You can't run or sneak while using the Dowsing Machine, though."), MSGBOX_NPC)
	}
	release
	end
}

// Signs

script OlsternCitySign {
	call(EventScript_BufferTime)
	msgbox("Olstern City, {STR_VAR_1}:{STR_VAR_2}{STR_VAR_3}", MSGBOX_SIGN)
	end
}

script OlsternCityOldIronworksSign {
	msgbox("Fuego Ironworks - ??? Branch\n"
	       "-- NO LONGER IN OPERATION --", MSGBOX_SIGN)
}

script OlsternCityGymSign {
	msgbox("Olstern City Pokémon Gym\nLeader: Redbeard\l"
		   "The ????????????!", MSGBOX_SIGN)
	end
}

script OlsternBeachSign {
	msgbox(format("Olstern Beach"), MSGBOX_SIGN)
	end
}

// Triggers

script OlsternTammyTrigger {
	lock
	setvar(VAR_OLSTERN_CITY_STATE, OLSTERN_STATE_TAMMY_ENCOUNTER_START)
	warpsilent(MAP_MAUVILLE_CITY, 37, 28)
	waitstate
	release
	end
}

script OlsternR4RoadblockTrigger {
	lock
	switch(getplayery) {
		case 30:
			applymovement(LOCALID_OLSTERN_ROADBLOCK, moves(walk_in_place_fast_up))
			waitmovement(0)
			exclam(LOCALID_OLSTERN_ROADBLOCK)
			turnobject(OBJ_EVENT_ID_PLAYER, DIR_SOUTH)
		case 32:
		case 33:
			applymovement(LOCALID_OLSTERN_ROADBLOCK, moves(walk_in_place_fast_down))
			waitmovement(0)
			exclam(LOCALID_OLSTERN_ROADBLOCK)
			turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
	}
	if(!checkplayergender) {
		bufferstring(STR_VAR_1, "sir")
	} else {
		bufferstring(STR_VAR_1, "miss")
	}
	msgbox("Excuse me, {STR_VAR_1}! Reno Boardwalk is\n"
	       "currently undergoing construction, so\l"
		   "we can't allow anyone through the\lroute.\p"
		   "The good news is we're wrapping up on\n"
		   "construction now, so it won't take long\l"
		   "for the route to reopen.", MSGBOX_NPC)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
	waitmovement(0)
	release
	end
}

script OlsternFakeAideTrigger {
	lock
	addobject(LOCALID_OLSTERN_AIDE)
	applymovement(LOCALID_OLSTERN_AIDE, moves(walk_Left * 4))
	waitmovement(0)
	switch(getplayery) {
		case 30:
			applymovement(LOCALID_OLSTERN_AIDE, moves(walk_left * 4
			                                  walk_in_place_fast_up))
			waitmovement(0)
			applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_fast_down))
		case 31:
			applymovement(LOCALID_OLSTERN_AIDE, moves(walk_left * 3))
			waitmovement(0)
			applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_fast_right))
		case 32:
			applymovement(LOCALID_OLSTERN_AIDE, moves(walk_left * 4
			                                  walk_in_place_fast_down))
			waitmovement(0)
			applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_fast_up))
		case 33:
			applymovement(LOCALID_OLSTERN_AIDE, moves(walk_down
											  walk_left * 4
			                                  walk_in_place_fast_down))
			waitmovement(0)
			applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_fast_up))
	}
	waitmovement(0)
	fadenewbgm(MUS_DUMMY)
	message("T{PAUSE 8}O{PAUSE 8} {PAUSE 8}B{PAUSE 8}E{PAUSE 8} {PAUSE 8}C{PAUSE 8}O{PAUSE 8}N{PAUSE 8}T{PAUSE 8}I{PAUSE 8}N{PAUSE 8}U{PAUSE 8}E{PAUSE 8}D{PAUSE 360}")
	fadescreenspeed(FADE_TO_BLACK, 8)
	waitmessage
	closemessage
	special(DoSoftReset)
	// TODO: Player and harley are kidnapped by pirates and thrown overboard mid-sail
	//       where they shore up on a small beach in the jungle north of Savage Bay
	//removeovject(LOCALID_OLSTERN_AIDE)
	//setvar(VAR_OLSTERN_CITY_STATE, OLSTERN_STATE_KIDNAPPED)
	//warpsilent(MAP_SAVAGE_BAY, 31, 28)
	waitstate
	release
	end
}