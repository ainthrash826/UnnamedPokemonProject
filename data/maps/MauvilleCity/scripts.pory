mapscripts MauvilleCity_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_VISITED_OLSTERN_CITY)
		end
	}
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_OLSTERN_CITY_STATE, OLSTERN_STATE_TAMMY_ENCOUNTER_START {hideobjectat(LOCALID_PLAYER, MAP_MAUVILLE_CITY)}
	]
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_OLSTERN_CITY_STATE, OLSTERN_STATE_TAMMY_ENCOUNTER_START {
			lock
			// Todo
			fadedefaultbgm
			showobjectat(OBJ_EVENT_ID_PLAYER, MAP_MAUVILLE_CITY)
			removeobject(LOCALID_OLSTERN_TAMMY)
			setvar(VAR_OLSTERN_CITY_STATE, OLSTERN_STATE_TAMMY_ENCOUNTER_END)
			release
			end
		}
		VAR_OLSTERN_CITY_STATE, OLSTERN_STATE_GYM_DEFEATED {
			lock
			playbgm(MUS_NONE, FALSE)
			playse(SE_M_EXPLOSION)
			delay(10)
			playse(SE_M_EXPLOSION)
			delay(10)
			playse(SE_M_EXPLOSION)
			delay(10)
			playse(SE_M_EXPLOSION)
			delay(10)
			playse(SE_M_EXPLOSION)
			delay(10)
			playse(SE_M_EXPLOSION)
			delay(10)
			playse(SE_M_EXPLOSION)
			delay(10)
			playse(SE_M_EXPLOSION)
			waitse
			exclam(OBJ_EVENT_ID_PLAYER)
			msgbox(format("It sounded like that loud explosion came from inside the ??? Cave!"), MSGBOX_AUTOCLOSE)
			fadedefaultbgm
			setvar(VAR_UMN_CAVE_STATE, UMN_CAVE_STATE_CAVE_IN_CLEARED)
			setvar(VAR_OLSTERN_CITY_STATE, OLSTERN_STATE_EXPLOSION_HEARD)
			clearflag(FLAG_HIDE_MAP_NAME_POPUP)
			release
			end
		}
