script BufferChestCountMsgbox {
    addvar(NUM_OPENED_CHESTS, 1)
    if(var(NUM_OPENED_CHESTS) == 1) {
        msgbox("It's a treasure chest!", MSGBOX_AUTOCLOSE)
    } else {
        buffernumberstring(STR_VAR_1, NUM_OPENED_CHESTS)
        msgbox("It's a treasure chest!\nThat makes {STR_VAR_1}!", MSGBOX_AUTOCLOSE)
    }
    playse(SE_TRUCK_DOOR)
}

const TREASURE_CHANCE = 99 // Defualt 35

script RandomTreasureChance {
    //random(100)
    //buffernumberstring(STR_VAR_1, VAR_RESULT)
    //message("ROLLED A {STR_VAR_1}{PAUSE 40}")
    //waitmessage
    //if(var(VAR_RESULT) < TREASURE_CHANCE) {
    if(random(100) < TREASURE_CHANCE) {
        msgbox(ImperialGym_Text_SomethingInChest)
        random(5)
        addvar(VAR_RESULT, 1)
        copyvar(VAR_TEMP_A, VAR_RESULT)
        if(random(16) <= 9) { // Rolled 1-10, find item
            switch(var(VAR_RESULT)) {
                case 0:
                case 5:
                    finditem(ITEM_NUGGET, VAR_TEMP_A)
                case 1:
                case 3:
                    finditem(ITEM_PEARL, VAR_TEMP_A)
                case 2:
                case 4:
                    finditem(ITEM_RARE_BONE, VAR_TEMP_A)
                case 6:
                    random(2)
                    addvar(VAR_RESULT, 1)
                    finditem(ITEM_KINGS_ROCK, VAR_RESULT)
                case 7:
                    random(2)
                    addvar(VAR_RESULT, 1)
                    finditem(ITEM_AMULET_COIN, VAR_RESULT)
                case 8:
                    random(2)
                    addvar(VAR_RESULT, 1)
                    finditem(ITEM_BIG_PEARL, VAR_RESULT)
                case 9:
                    finditem(ITEM_PEARL_STRING)
            }
        } else { // Rolled 11-16, start wild mon battle
            setflag(FLAG_TEMP_10)
            closemessage
            delay(16)
            switch(var(VAR_RESULT)) {
                case 10:
                case 14:
                    setwildbattle(SPECIES_CLAMPERL, 11)
                    dowildbattle
                    setvar(VAR_TEMP_D, ITEM_PEARL)
                case 11:
                case 13:
                    setwildbattle(SPECIES_MAREANIE, 11)
                    dowildbattle
                    setvar(VAR_TEMP_D, ITEM_POISON_BARB)
                    setvar(VAR_TEMP_E, 1)
                case 12:
                case 15:
                    setwildbattle(SPECIES_GIMMIGHOUL_ROAMING, 11)
                    dowildbattle
                    setvar(VAR_TEMP_D, ITEM_GIMMIGHOUL_COIN)
                case 16:
                    setwildbattle(SPECIES_HUNTAIL, 19)
                    dowildbattle
                    setvar(VAR_TEMP_D, ITEM_DEEP_SEA_TOOTH)
                    setvar(VAR_TEMP_E, 1)
            }
            call(StaticMonItemDropChance)
        }
    }
}

text ImperialGym_Text_SomethingInChest {format("Hey, there's something in this chest!")}
text ImperialGym_Text_ChestAlreadyOpened {format("This chest is already open.")}

