const LOCALID_LEON = 1
const LOCALID_GRUNT = 2
const LOCALID_ILANNA = 3
const LOCALID_ADMIN1 = 4
const LOCALID_ADMIN2 = 5
const LOCALID_SNORUNT2 = 7

mapscripts CentraNE_PokemonAcademy1F_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_VAST_WOODS_STATE, 0 {
            savebgm(MUS_NONE)
            hideobjectat(LOCALID_PLAYER, MAP_CENTRA_NE_POKEMON_ACADEMY1F)
            hideobjectat(LOCALID_ADMIN1, MAP_CENTRA_NE_POKEMON_ACADEMY1F)
            hideobjectat(LOCALID_ADMIN2, MAP_CENTRA_NE_POKEMON_ACADEMY1F)
            hideobjectat(LOCALID_ILANNA, MAP_CENTRA_NE_POKEMON_ACADEMY1F)
            end
        }
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_VAST_WOODS_STATE, VAST_WOODS_STATE_SUBZERO_HIDEOUT_CUTSCENE {
            lock
            applymovement(LOCALID_LEON, moves(walk_left * 2
                                              walk_right * 3
                                              walk_left * 3
                                              walk_right * 3
                                              walk_left
                                              walk_in_place_fast_down))
            delay(80)
            applymovement(LOCALID_GRUNT, Common_Movement_WalkInPlaceUp)
            waitmovement(LOCALID_LEON)
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: Yo, any word from the Boss yet? She should've been here by now."))
            applymovement(LOCALID_GRUNT, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Grant{COLOR DARK_GRAY}: Leon, you gotta chill out!\nShe'll be here any minute."))
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: Yeah, I know. But we're short a person and three whole Pokémon!\lDo you really think she'll take that kind of news lightly?"))
            applymovement(LOCALID_GRUNT, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Grant{COLOR DARK_GRAY}: Again, you gotta relax dude!\nAs long as you tell the truth like you said you would, we'll be fine.\p"
                          "And no, I don't think she's the type of person to trip over something slightly inconvenient, anyway."))
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: Huh.{PAUSE 40}\nI guess you're right."), MSGBOX_AUTOCLOSE)
            applymovement(LOCALID_LEON, moves(walk_left * 2
                                              walk_right * 3
                                              walk_left * 2
                                              walk_in_place_fast_down))
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: I'm gonna grab a drink.\nYou want anything?"))
            applymovement(LOCALID_GRUNT, Common_Movement_WalkInPlaceRight)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Grant{COLOR DARK_GRAY}: Just get me a Fresh Water, thanks."))
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: Aight."), MSGBOX_AUTOCLOSE)
            delay(8)
            applymovement(LOCALID_LEON, moves(walk_down * 2
                                              walk_right * 8))
            delay(80)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_diag_northwest * 5
                                                     walk_left
                                                     delay_16))
            waitmovement(0)
            setobjectxy(LOCALID_LEON, 11, 7)
            setobjectxy(LOCALID_GRUNT, 7, 9)
            playse(SE_EXIT)
            applymovement(LOCALID_ILANNA, moves(set_visible
                                                walk_down))
            waitse
            msgbox("{COLOR RED}???{COLOR DARK_GRAY}: Please excuse our tardiness.", MSGBOX_AUTOCLOSE)
            playse(SE_EXIT)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(delay_16 * 3
                                                     walk_down
                                                     walk_right * 4
                                                     walk_down))
            applymovement(LOCALID_ILANNA, moves(walk_down
                                                lock_facing_direction
                                                walk_left
                                                walk_right
                                                unlock_facing_direction
                                                walk_down
                                                walk_right * 4
                                                walk_in_place_fast_down))
            applymovement(LOCALID_ADMIN1, moves(set_visible
                                                walk_down * 3
                                                walk_right * 5
                                                walk_in_place_fast_down))
            applymovement(LOCALID_ADMIN2, moves(delay_16 * 2
                                                set_visible
                                                walk_down * 3
                                                walk_right * 3
                                                walk_in_place_fast_down))
            applymovement(LOCALID_LEON, moves(emote_exclamation_mark
                                              walk_fast_left * 3
                                              walk_fast_up
                                              walk_in_place_fast_up))
            applymovement(LOCALID_GRUNT, moves(emote_exclamation_mark
                                               walk_fast_up * 2
                                               walk_fast_left
                                               walk_fast_up
                                               walk_in_place_fast_up))
            delay(32)
            playse(SE_EXIT)
            playbgm(MUS_AQUA_MAGMA_HIDEOUT, TRUE)
            waitmovement(LOCALID_ADMIN2)
            delay(30)
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceUp)
            applymovement(LOCALID_GRUNT, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            msgbox(format("Both: Boss!"))
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: Don't even worry about being late, ma'am. It's all cool!"))
            applymovement(LOCALID_ILANNA, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox(format("{COLOR RED}Boss{COLOR DARK_GRAY}: You seem to be short a person.\nAny explanations?"))
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            if(flag(FLAG_LOST_FIRST_BATTLE)) {
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: Well, you see Boss, the three Pokémon you gave to the three of us suddenly ran out of the hideout and out of the Woods.\p"
                          "We all trailed behind them, but by the time we caught up to them, the Pokémon were hiding behind some random kid.\p"
                          "{COLOR RED}Harley{COLOR DARK_GRAY} and I got into a fight, and she ended up battling against us with the rando.\p"
                          "We defeated them, but both {COLOR RED}Harley{COLOR DARK_GRAY} and the kid took the Pokémon and ran towards Woodridge after the battle.\p"
                          "Grant and I retreated back to this hideout, and haven't seen any of them since yesterday."))
            } else {
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: Well, you see Boss, the three Pokémon you gave to the three of us suddenly ran out of the hideout and out of the Woods.\p"
                          "We all trailed behind them, but by the time we caught up to them, the Pokémon were hiding behind some random kid.\p"
                          "{COLOR RED}Harley{COLOR DARK_GRAY} and I got into a fight, and she ended up battling against us with the rando.\p"
                          "After the battle, both {COLOR RED}Harley{COLOR DARK_GRAY} and the kid took the Pokémon and ran towards Woodridge.\p"
                          "Grant and I retreated back to this hideout, and haven't seen any of them since yesterday."))
            }
            applymovement(LOCALID_ILANNA, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox(format("{COLOR RED}Boss{COLOR DARK_GRAY}: Did you happen to get the kid's name?"))
            applymovement(LOCALID_GRUNT, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            if(!checkplayergender){
                bufferstring(STR_VAR_1, "")
                bufferstring(STR_VAR_2, "{COLOR BLUE}")
            } else {
                bufferstring(STR_VAR_1, "s")
                bufferstring(STR_VAR_2, "{COLOR RED}")
            }
            msgbox("{COLOR BLUE}Grant{COLOR DARK_GRAY}: We did, ma'am!\n It's {STR_VAR_2}{PLAYER}{COLOR DARK_GRAY}.\p"
                   "We were able to catch it before {STR_VAR_1}he and\n"
                   "{COLOR RED}Harley{COLOR DARK_GRAY} bolted off!")
            applymovement(LOCALID_ILANNA, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox("Boss: {STR_VAR_2}{PLAYER}{COLOR DARK_GRAY}… {PAUSE 45}Interesting.\n"
                   "{PAUSE 45}As for {COLOR RED}Harley{COLOR DARK_GRAY}, I can already tell she was\l"
                   "going to be a problem.\p"
                   "But, if she's now willing to go AWOL and\n"
                   "bring a stranger into this such as\l"
                   "this {STR_VAR_2}{PLAYER}{COLOR DARK_GRAY} you speak of, then that\l"
                   "must mean…")
            exclam(LOCALID_ILANNA)
            msgbox(format("{COLOR RED}Boss{COLOR DARK_GRAY}: Pardon me, it seems we've gone a bit off-track.\p"
                          "You three had been assigned a mission here. Were you able to complete it?"))
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceUp)
            applymovement(LOCALID_GRUNT, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            msgbox(format("Both: Yes, ma'am!\p"
                          "{COLOR BLUE}Leon{COLOR DARK_GRAY}: We were able to locate and excavate some debris from what seems to be a satellite scattered throughout the Woods!"))
            applymovement(LOCALID_ILANNA, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox(format("{COLOR RED}Boss{COLOR DARK_GRAY}: Excellent to hear.{PAUSE 40} Leon, your continued loyalty to Subzero has rightfully landed you a promotion to General.\pCongratulations."))
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: It is an honor, Boss!"))
            applymovement(LOCALID_ILANNA, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox(format("{COLOR RED}Boss{COLOR DARK_GRAY}: As for {COLOR RED}Harley{COLOR DARK_GRAY}, she's now wanted for treason."))
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: I see…"))
            applymovement(LOCALID_ILANNA, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox(format("{COLOR RED}Boss{COLOR DARK_GRAY}: I'm not sending a specialized group or anything of that sort to look for her, however.\p"
                          "I'm leaving that solely in the hands of you, Leon, as your first mission as General.\p"
                          "Find {COLOR RED}Harley{COLOR DARK_GRAY}.{PAUSE 40}\nI want her alive."))
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Leon{COLOR DARK_GRAY}: Yes, ma'am!"))
            applymovement(LOCALID_ILANNA, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox(format("{COLOR RED}Boss{COLOR DARK_GRAY}: This is also a reminder to the now both of you about the mandatory meeting at the main HQ in the very near future, so make sure to check your email for updates.\p"
                          "Until this meeting, Leon, I order you to stay put in this hideout until further notice. Grant's coming back to HQ with me."))
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceUp)
            applymovement(LOCALID_GRUNT, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            msgbox(format("Both: Yes, Boss!"))
            applymovement(LOCALID_ILANNA, moves(walk_in_place_fast_right))
            waitmovement(0)
            message(format("{COLOR RED}Boss{COLOR DARK_GRAY}: You two. {PAUSE 48}Grab the scrap they found and meet us outside."))
            delay(20)
            applymovement(LOCALID_ADMIN1, moves(walk_in_place_fast_left))
            applymovement(LOCALID_ADMIN2, moves(walk_in_place_fast_right))
            delay(20)
            applymovement(LOCALID_ILANNA, moves(walk_in_place_fast_left))
            waitmessage
            waitbuttonpress
            applymovement(LOCALID_ADMIN1, moves(walk_down
                                                walk_left
                                                walk_down * 2
                                                walk_right * 9))
            applymovement(LOCALID_ADMIN2, moves(delay_16
                                                walk_down
                                                walk_right
                                                walk_down * 2
                                                walk_right * 8))
            applymovement(LOCALID_ILANNA, moves(walk_in_place_fast_down))
            delay(48)
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceUp)
            waitmovement(0)
            if(!checkplayergender){
                bufferstring(STR_VAR_1, "im")
                bufferstring(STR_VAR_2, "{COLOR BLUE}")
            } else {
                bufferstring(STR_VAR_1, "er")
                bufferstring(STR_VAR_2, "{COLOR RED}")
            }
            msgbox("{COLOR BLUE}Leon{COLOR DARK_GRAY}: Wait! Boss, what do you\nplan on doing about {STR_VAR_2}{PLAYER}{COLOR DARK_GRAY}?")
            applymovement(LOCALID_ILANNA, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox("{COLOR RED}Boss{COLOR DARK_GRAY}: {STR_VAR_2}{PLAYER}{COLOR DARK_GRAY}…{PAUSE 40}\nI'll just simply leave h{STR_VAR_1} in the hands\l"
                   "of a good friend of mine.\p"
                   "Alright.\nLet's get going, Grant.")
            applymovement(LOCALID_GRUNT, Common_Movement_WalkInPlaceUp)
            applymovement(LOCALID_LEON, Common_Movement_WalkInPlaceLeft)
            waitmovement(0)
            msgbox(format("{COLOR BLUE}Grant{COLOR DARK_GRAY}: Yes, Boss!"))
            applymovement(LOCALID_GRUNT, Common_Movement_WalkInPlaceDown)
            waitmovement(0)
            msgbox(format("Let's go, Snorunt!"))
            closemessage
            applymovement(LOCALID_SNORUNT2, moves(walk_left * 3
                                                  walk_up * 7
                                                  walk_left * 3
                                                  walk_up * 3
                                                  set_invisible))
            delay(112)
            applymovement(LOCALID_ILANNA, moves(walk_left * 4
                                                walk_up * 3
                                                set_invisible))
            applymovement(LOCALID_GRUNT, moves(walk_up * 2
                                               walk_left * 3 
                                               walk_up * 3
                                               set_invisible))
            applymovement(LOCALID_ADMIN2, moves(face_right
                                                lock_facing_direction
                                                walk_left * 9
                                                unlock_facing_direction
                                                face_down
                                                lock_facing_direction
                                                walk_up * 3
                                                unlock_facing_direction
                                                face_right
                                                lock_facing_direction
                                                walk_left * 3
                                                unlock_facing_direction
                                                face_down
                                                lock_facing_direction
                                                walk_up * 3
                                                set_invisible))
            applymovement(LOCALID_ADMIN1, moves(walk_left * 9
                                                face_up
                                                lock_facing_direction
                                                walk_left
                                                walk_up * 2
                                                unlock_facing_direction
                                                face_left
                                                lock_facing_direction
                                                walk_up
                                                walk_left * 2
                                                unlock_facing_direction
                                                face_up
                                                lock_facing_direction
                                                walk_left
                                                walk_up * 3
                                                set_invisible))
            delay(16)
            waitmovement(LOCALID_ILANNA)
            playse(SE_EXIT)
            applymovement(LOCALID_LEON, moves(walk_in_place_fast_down))
            waitmovement(LOCALID_GRUNT)
            playse(SE_EXIT)
            waitmovement(LOCALID_SNORUNT2)
            playse(SE_EXIT)
            applymovement(LOCALID_LEON, moves(walk_in_place_fast_left))
            delay(32)
            waitmovement(LOCALID_ADMIN2)
            playse(SE_EXIT)
            waitmovement(LOCALID_ADMIN1)
            playse(SE_EXIT)
            waitse
            fadenewbgm(MUS_DUMMY)
            fadescreen(FADE_TO_BLACK)
			setflag(FLAG_HIDE_VAST_WOODS_SUBZERO_HIDEOUT_NPCS)
            setvar(VAR_VAST_WOODS_STATE, 1)
            resumefakertc
            delay(75)
            warpnofade(MAP_LITTLEROOT_TOWN_PROFESSOR_BIRCHS_LAB, 13, 6)
            waitstate
            release
            end
        }
    ]
}
